    {
      "name": "Day 2 API Tests",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"preserves health response\", function () { pm.expect(pm.response.json()).to.eql({ status: \"healthy\", message: \"Mini API is running\" }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health"
            }
          },
          "response": []
        },
