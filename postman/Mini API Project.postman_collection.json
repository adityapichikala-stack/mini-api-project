              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"returns country details\", function () { pm.expect(pm.response.json()).to.have.all.keys(\"country\", \"capital\", \"currency\"); });"
